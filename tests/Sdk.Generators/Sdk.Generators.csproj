<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- MSTest Runner Configuration -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- Disable CA1515 - MSTest requires public test classes -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <!-- The project name 'Sdk.Generators' keeps Directory.Build.targets from also wiring the
       generator in as an analyzer; the tests drive it explicitly through Roslyn instead. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdk.Generators\Sdk.Generators.csproj" />
    <ProjectReference Include="..\..\src\Sdk\Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="MSTest.Analyzers" />
    <!-- TemplateModelGenerator output references Scriban; tests compile and run it. -->
    <PackageReference Include="Scriban" />
    <!-- BannedPluginApiTests run the real RS0030 analyzer against the SDK's plugin ban list.
         The analyzer is loaded explicitly, never added to this project's own compilation. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/*.dll"
          Link="BannedApiAnalyzers/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="..\..\src\Sdk\build\BannedSymbols.RevelaPlugin.txt" Link="Sdk\BannedSymbols.RevelaPlugin.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK package readme is compile-checked by SdkReadmeSnippetTests. -->
    <None Include="..\..\src\Sdk\README.md" Link="Docs\Sdk.README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
