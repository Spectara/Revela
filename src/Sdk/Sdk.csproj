<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>SDK for building Revela plugins and themes. Provides interfaces, models, and base classes for plugin and theme development.</Description>
    <AssemblyName>Spectara.Revela.Sdk</AssemblyName>
    <PackageId>Spectara.Revela.Sdk</PackageId>
    <PackageTags>revela;sdk;plugin;theme;photography;static-site-generator</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_RevelaPackSourceGenerator</TargetsForTfmSpecificContentInPackage>
    <!-- Sdk must be trim- and AOT-safe so it can be consumed by Cli.Embedded
         (static AOT host) and by 3rd-party plugin authors who want to publish
         trimmed/AOT-compatible plugins. Setting IsAotCompatible=true also
         enables IsTrimmable, EnableTrimAnalyzer, EnableSingleFileAnalyzer and
         EnableAotAnalyzer (see https://learn.microsoft.com/dotnet/core/deploying/native-aot/#aot-compatibility-analyzers). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- MSBuild targets for plugin/theme projects - auto-imported via NuGet -->
  <ItemGroup>
    <None Include="build/Spectara.Revela.Sdk.targets" Pack="true" PackagePath="build/Spectara.Revela.Sdk.targets" />
    <None Include="build/Spectara.Revela.Sdk.targets" Pack="true" PackagePath="buildTransitive/Spectara.Revela.Sdk.targets" />
    <None Include="build/BannedSymbols.RevelaPlugin.txt" Pack="true" PackagePath="build/BannedSymbols.RevelaPlugin.txt" />
    <None Include="build/BannedSymbols.RevelaPlugin.txt" Pack="true" PackagePath="buildTransitive/BannedSymbols.RevelaPlugin.txt" />
  </ItemGroup>

  <!-- RS0030 analyzer for the plugin configuration ban in build/Spectara.Revela.Sdk.targets.
       Only the analyzer flows to consumers (in-repo ProjectReferences and the NuGet dependency);
       it reports nothing without the ban list, which only plugin/theme projects receive. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers"
                      IncludeAssets="analyzers"
                      PrivateAssets="compile;runtime;native;contentfiles;build;buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- Minimal dependencies - abstractions only! -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <!-- Bundles the .NET Configuration Binding Source Generator (CBSG)
         analyzer; CBSG intercepts the BindConfiguration calls inside
         AddRevelaConfigSections and emits a trim/AOT-safe typed binder.
         The runtime reflection-based binder shipped in the same package is
         unused after interception and trimmed away by ILLink. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!-- Public API tracking: every public SDK change must be recorded in PublicAPI.Unshipped.txt
       (RS0016 new API / RS0017 removed API; errors via TreatWarningsAsErrors), so it is visible in
       review. Move entries to PublicAPI.Shipped.txt when a release is published to nuget.org.
       PrivateAssets keeps the analyzer out of the SDK package's dependencies. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <Target Name="_RevelaPackSourceGenerator" DependsOnTargets="PrepareProjectReferences">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="GetTargetPath"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove);%(_MSBuildProjectReferenceExistent.UndefineProperties);$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'%(_MSBuildProjectReferenceExistent.OutputItemType)' == 'Analyzer'">
      <Output TaskParameter="TargetOutputs" ItemName="_RevelaAnalyzerTargetPath" />
    </MSBuild>
    <ItemGroup>
      <_RevelaGenerator Include="@(_RevelaAnalyzerTargetPath)"
                        Condition="'%(_RevelaAnalyzerTargetPath.Filename)' == 'Spectara.Revela.Sdk.Generators'" />
    </ItemGroup>
    <Error Condition="'@(_RevelaGenerator->Count())' != '1'"
           Text="Expected exactly one resolved Revela generator analyzer for SDK packaging." />
    <Error Condition="!Exists('%(_RevelaGenerator.Identity)')"
           Text="The Revela generator analyzer must be built before SDK packaging: %(_RevelaGenerator.Identity)" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_RevelaGenerator)" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
  </Target>

</Project>
