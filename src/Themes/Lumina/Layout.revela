{{~##
Main Layout Template - Lumina Theme

Main layout for all pages, supports dynamic body templates.

Expects:
- site: { title, description, author, copyright }
- gallery: { title, body?, template? }
- nav_items: Array of NavigationItem for navigation
- images: Array of ImageData of this page (optional)
- occurrences: Array of { image, ... } for the page's photo grid, in display order
- basepath: Relative path to root
- assets_basepath: Path/URL to image resources (can be absolute CDN URL)
- image_formats: Array of format strings ["avif", "webp", "jpg"]
- stylesheets: Array of CSS paths relative to _assets/
- scripts: Array of JS paths relative to _assets/
- base_url: Absolute site URL (optional) - enables canonical and absolute Open Graph URLs
- og_locale: Open Graph locale derived from site.language (e.g. "de_DE")
- not_found: true only for 404.html (rendered with body/notfound, root-absolute basepath)

Body Template Selection:
- Default: "gallery" (shows images and optional intro text)
- Custom: Specify in _index.revela frontmatter: template = "page"
- Extension templates: "statistics/overview" etc.
- 404 page: "notfound"
The layout includes "body/" + template, e.g. Body/Page.revela for template = "page".

Headings: the layout renders no heading of its own. Every body template renders
exactly one <h1> for the page (visually hidden where the design shows no title).
##~}}
{{~ page_title = not_found ? (t 'notfound.title') : gallery.title ~}}
{{~ page_description = gallery.description ?? site.description ~}}
{{~ canonical_url = (base_url && !not_found) ? (absolute_url gallery) : null ~}}
{{~ # Social preview image: the cover image, else the first photo the page shows (none on a page without photos) ~}}
{{~ og_image = gallery.cover_image ?? ((occurrences && occurrences.size > 0) ? occurrences[0].image : null) ~}}
<!DOCTYPE html>
<html lang="{{ html_escape (site.language ?? 'en') }}">

<head>
    <meta charset="UTF-8">
    {{~ # The home page's title falls back to the site title; don't print it twice. ~}}
    <title>{{~ if page_title && page_title != site.title ~}}{{ html_escape site.title }} - {{ html_escape page_title }}{{~ else ~}}{{ html_escape site.title }}{{~ end ~}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ html_escape page_description }}">
    <meta name="author" content="{{ html_escape site.author }}">
    <meta name="generator" content="Revela {{ html_escape revela.version }}">
    {{~ if not_found ~}}
    <meta name="robots" content="noindex">
    {{~ end ~}}
    {{~ if canonical_url ~}}
    <link rel="canonical" href="{{ html_escape canonical_url }}">
    {{~ end ~}}
    {{~ if !not_found ~}}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ html_escape site.title }}">
    <meta property="og:title" content="{{ html_escape (page_title ?? site.title) }}">
    {{~ if page_description ~}}
    <meta property="og:description" content="{{ html_escape page_description }}">
    {{~ end ~}}
    {{~ if canonical_url ~}}
    <meta property="og:url" content="{{ html_escape canonical_url }}">
    {{~ end ~}}
    {{~ if og_locale != '' ~}}
    <meta property="og:locale" content="{{ html_escape og_locale }}">
    {{~ end ~}}
    {{~ include 'opengraphimage' ~}}
    {{~ end ~}}
    {{~ include 'favicon' ~}}
    {{~ for css in stylesheets ~}}
    <link type="text/css" rel="stylesheet" media="all" href="{{ html_escape (asset_url css) }}">
    {{~ end ~}}
</head>

<body>
    {{~ # Main Navigation (Fullscreen Overlay) ~}}
    <nav id="site-menu" popover="auto" aria-label="{{ html_escape (t 'nav.menu') }}">
        {{~ include 'navigation' nav_items ~}}
    </nav>

    {{~ # Sticky Header ~}}
    <header>
        <div>
            {{~ # Site name is branding, not a heading: each page's own <h1> stays the first heading. ~}}
            <p>
                <button type="button" popovertarget="site-menu" title="{{ html_escape (t 'nav.menu') }}">
                    <span class="visually-hidden">{{ html_escape (t 'nav.menu') }}</span>
                    <span aria-hidden="true">i</span>
                    <span aria-hidden="true">i</span>
                    <span aria-hidden="true">i</span>
                </button>
                {{~ # basepath is empty string at root, "../" for galleries, or "/photos/" for subdirectory hosting ~}}
                <a href="{{ html_escape (basepath == '' ? '.' : basepath) }}">{{ html_escape site.title }}</a>
            </p>
            <nav aria-label="{{ html_escape (t 'nav.primary') }}">
                {{~ include 'HeaderNavigation' ~}}
            </nav>
        </div>
    </header>

    {{~ # Main Content ~}}
    <main>
        {{~##
        Dynamic Body Template Inclusion

        All body templates are included dynamically with full context.
        Extension templates define data defaults in manifest.json, so users
        can simply specify template = "statistics/overview" without
        explicit data configuration.

        Examples:
        - template = "page" → Body/Page.revela, simple text page
        - template = "gallery" → Body/Gallery.revela, image gallery (default)
        - template = "statistics/overview" → Statistics extension template
        ##~}}
        {{~ body_template = 'body/' + (gallery.template ?? 'gallery') ~}}
        {{~ include body_template ~}}
    </main>

    {{~ # Footer with Navigation Copy ~}}
    <footer>
        <nav aria-label="{{ html_escape (t 'nav.site') }}">
            {{~ include 'navigation' nav_items ~}}
        </nav>
        <div>
            {{ site.copyright }}
        </div>
    </footer>

    {{~ # Scripts (deferred — non-render-blocking, keeps them off the critical request chain) ~}}
    {{~ for js in scripts ~}}
    <script src="{{ html_escape (asset_url js) }}" defer></script>
    {{~ end ~}}
</body>

</html>
