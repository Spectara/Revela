{
  "name": "Lumina",
  "version": "1.0.0",
  "description": "Lumina - elegant photography portfolio theme",
  "author": "Spectara",
  "previewImage": "https://revela.website/themes/lumina/preview.jpg",
  "tags": [
    "photography",
    "gallery",
    "photo-pages",
    "responsive"
  ],
  "templates": {
    "layout": "Layout.revela"
  },
  "photoViewers": [
    "page",
    "lightbox",
    "none"
  ],
  "defaultPhotoViewer": "page",
  "stylesheets": [
    {
      "path": "main.css"
    },
    {
      "path": "photo.css",
      "scope": [
        "photo"
      ]
    }
  ],
  "scripts": [
    {
      "path": "lightbox.js",
      "scope": [
        "lightbox"
      ]
    },
    {
      "path": "zoom.js",
      "scope": [
        "photo",
        "lightbox"
      ]
    }
  ]
}