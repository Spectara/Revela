{{~##
Photo Page Body - Lumina Theme (#77)

A standalone, image-led photo page served at /photo/{slug}/. Unlike gallery pages it has
no site header or overlay-menu trigger. Navigation works without JavaScript; the scoped zoom
script progressively adds pinch, double-tap, and pan gestures, and photo.js adds the Left/Right
arrow keys for the previous/next links of the shown context. When opened directly (no fragment /
no referrer), the primary context is shown by default and an unknown/stale #ctx-* fragment falls
back to it via CSS (:target + :has).

Template contract:
- photo: { image, slug, title, primary_context, contexts }
- image: ImageData { id, slug, width, height, title?, description?, keywords, rating?, exif?, sizes, color? }
- contexts: PhotoContext[] { route, label, context_id, anchor, is_physical, previous_photo?, next_photo? }
- primary_context: PhotoContext
- site, base_url, basepath, assets_basepath, image_formats, stylesheets, scripts, revela
- helpers: page_url, absolute_url, asset_url, variant_url (+ Partials/ImageHelpers)
##~}}
{{~ include 'imagehelpers' ~}}
{{~ fallback_format = image_fallback_format ~}}
{{~ # Fit the viewport; zoom.js switches sizes to the original width when zooming in. ~}}
{{~ photo_sizes = viewer_sizes image ~}}
{{~ alt_text = image.title ?? '' ~}}
{{~ image_description = image.description ?? '' ~}}
{{~ description = alt_text != '' ? alt_text : (site.description ?? '') ~}}
{{~ display_label = alt_text != '' ? alt_text : (image_description != '' ? image_description : image.id) ~}}
{{~ heading = alt_text != '' ? alt_text : (t 'photo.label' image.id) ~}}
{{~ canonical_url = base_url ? (absolute_url image) : null ~}}
{{~ og_image = image ~}}
<!DOCTYPE html>
<html lang="{{ html_escape (site.language ?? 'en') }}">

<head>
    <meta charset="UTF-8">
    <title>{{ html_escape photo.title }}{{ html_escape (site.title ? ' - ' + site.title : '') }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    {{~ # System bars of installed web apps and mobile browsers follow the page background (--color-bg). ~}}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000">
    {{~ if description != '' ~}}
    <meta name="description" content="{{ html_escape description }}">
    {{~ end ~}}
    <meta name="generator" content="Revela {{ html_escape revela.version }}">
    {{~ if canonical_url ~}}
    <link rel="canonical" href="{{ html_escape canonical_url }}">
    {{~ end ~}}
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="{{ html_escape site.title }}">
    <meta property="og:title" content="{{ html_escape heading }}">
    {{~ if description != '' ~}}
    <meta property="og:description" content="{{ html_escape description }}">
    {{~ end ~}}
    {{~ if canonical_url ~}}
    <meta property="og:url" content="{{ html_escape canonical_url }}">
    {{~ end ~}}
    {{~ if og_locale != '' ~}}
    <meta property="og:locale" content="{{ html_escape og_locale }}">
    {{~ end ~}}
    {{~ include 'opengraphimage' ~}}
    {{~ include 'favicon' ~}}
    {{~ for css in stylesheets ~}}
    <link type="text/css" rel="stylesheet" media="all" href="{{ html_escape (asset_url css) }}">
    {{~ end ~}}
</head>

<body class="photo-page">
    <main>
        <h1 class="visually-hidden">{{ html_escape heading }}</h1>
        <article style="--width:{{ html_escape image.width }}; --height:{{ html_escape image.height }};{{~ if image.color ~}} --image-color:{{ html_escape image.color }};{{~ end ~}}">
            <picture id="photo-{{ html_escape image.id }}">
                {{~ for format in image_formats ~}}
                <source type="{{ html_escape (image_type format) }}" sizes="{{ html_escape photo_sizes }}" srcset="{{ html_escape (image_srcset image format) }}">
                {{~ end ~}}
                <img alt="{{ html_escape alt_text }}" src="{{ html_escape (variant_url image image.sizes[-1] fallback_format) }}"
                    sizes="{{ html_escape photo_sizes }}" srcset="{{ html_escape (image_srcset image fallback_format) }}"
                    width="{{ html_escape image.width }}" height="{{ html_escape image.height }}" fetchpriority="high" decoding="async">
            </picture>
            <section>
                <nav class="photo-nav" aria-label="{{ html_escape (t 'photo.navigation') }}">
                    {{~ for ctx in contexts ~}}
                    {{~ up_href = ctx.route == '' ? basepath : page_url(ctx.route) ~}}
                    <div id="ctx-{{ html_escape ctx.context_id }}"{{~ if ctx.context_id == primary_context.context_id }} data-primary{{ end }}>
                        <a data-photo-return rel="up" href="{{ html_escape up_href }}#{{ html_escape ctx.anchor }}" aria-label="{{ html_escape (t 'photo.return_to' ctx.label) }}">&times;</a>
                        {{~ if ctx.previous_photo ~}}
                        <a data-photo-previous rel="prev" href="{{ html_escape (page_url ctx.previous_photo) }}#ctx-{{ html_escape ctx.context_id }}" aria-label="{{ html_escape (t 'photo.previous_in' ctx.label) }}"><span aria-hidden="true">&lsaquo;</span></a>
                        {{~ else ~}}
                        <span data-photo-previous aria-hidden="true"></span>
                        {{~ end ~}}
                        <span data-photo-label>{{ html_escape display_label }}</span>
                        {{~ if ctx.next_photo ~}}
                        <a data-photo-next rel="next" href="{{ html_escape (page_url ctx.next_photo) }}#ctx-{{ html_escape ctx.context_id }}" aria-label="{{ html_escape (t 'photo.next_in' ctx.label) }}"><span aria-hidden="true">&rsaquo;</span></a>
                        {{~ else ~}}
                        <span data-photo-next aria-hidden="true"></span>
                        {{~ end ~}}
                    </div>
                    {{~ end ~}}
                </nav>
                {{~ include 'photometadata' image ~}}
                <footer>
                    <strong>{{ html_escape (t 'photo.seen_in') }}</strong>
                    {{~ shown_routes = {} ~}}
                    {{~ for ctx in contexts ~}}
                    {{~ if !shown_routes[ctx.route] ~}}
                    {{~ seen_href = ctx.route == '' ? basepath : page_url(ctx.route) ~}}
                    <a href="{{ html_escape seen_href }}#{{ html_escape ctx.anchor }}">{{ html_escape ctx.label }}</a>
                    {{~ shown_routes[ctx.route] = true ~}}
                    {{~ end ~}}
                    {{~ end ~}}
                </footer>
            </section>
        </article>
    </main>

    {{~ for js in scripts ~}}
    <script src="{{ html_escape (asset_url js) }}" defer></script>
    {{~ end ~}}
</body>

</html>
