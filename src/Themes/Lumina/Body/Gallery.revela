{{~##
Gallery Body Template

Renders the main content for a gallery page with images.
This is the default body template if no `template` is specified.

Expects:
- gallery: { title, body? }
- occurrences: Array of GalleryImageOccurrence
- image_formats: Array of format strings ["avif", "webp", "jpg"]
- assets_basepath: Path/URL to image resources
- basepath: Relative path to root (for navigation)

Heading: exactly one <h1> per page. The gallery title is the <h1> at the top of the
body, unless the Markdown body brings its own (`# Heading`). On the home page the
title stays visually hidden so the grid starts without a visible heading.
##~}}
{{~ is_home = (gallery.slug ?? '') == '' ~}}
{{~ body_has_h1 = gallery.body && (gallery.body | string.contains '<h1') ~}}
{{~ heading = (gallery.title && gallery.title != '') ? gallery.title : site.title ~}}
{{~ if is_home && !body_has_h1 ~}}
<h1 class="visually-hidden">{{ html_escape heading }}</h1>
{{~ end ~}}

{{~ # Gallery Introduction (rendered from _index.revela body using Markdig) ~}}
{{~ if gallery.body || (!is_home && !body_has_h1) ~}}
<section>
    {{~ if !is_home && !body_has_h1 ~}}
    <h1>{{ html_escape heading }}</h1>
    {{~ end ~}}
    {{ gallery.body }}
</section>
{{~ end ~}}

{{~ # Image Gallery Grid (suppressed when the body places its own [[gallery]] blocks) ~}}
{{~ if !gallery.has_inline_galleries && occurrences && occurrences.size > 0 ~}}
<section class="gallery">
    {{~ for occurrence in occurrences ~}}
    {{~ image = occurrence.image ~}}
    {{~ viewer_mode = occurrence.viewer_mode ~}}
    {{~ context_id = occurrence.context_id ~}}
    {{~ context_label = occurrence.context_label ~}}
    {{~ occurrence_id = occurrence.occurrence_id ~}}
    {{~ previous_occurrence_id = occurrence.previous_occurrence_id ~}}
    {{~ next_occurrence_id = occurrence.next_occurrence_id ~}}
    {{~ include 'image' image ~}}
    {{~ end ~}}
</section>
{{~ end ~}}
