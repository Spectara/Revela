{{~##
Header Navigation Partial

Renders pinned navigation items in the sticky header.
Searches recursively through all navigation levels to find pinned items.
Override this partial to add custom links (e.g., GitHub icon).

Expects:
- nav_items: Array of NavigationItem
- basepath: Relative path to root
##~}}
{{~ for item in nav_items ~}}
{{~ if item.pinned ~}}
<a href="{{ html_escape (page_url item) }}"{{ if item.current }} aria-current="page"{{ end }}>{{ html_escape item.text }}</a>
{{~ end ~}}
{{~ for child in item.children ~}}
{{~ if child.pinned ~}}
<a href="{{ html_escape (page_url child) }}"{{ if child.current }} aria-current="page"{{ end }}>{{ html_escape child.text }}</a>
{{~ end ~}}
{{~ for grandchild in child.children ~}}
{{~ if grandchild.pinned ~}}
<a href="{{ html_escape (page_url grandchild) }}"{{ if grandchild.current }} aria-current="page"{{ end }}>{{ html_escape grandchild.text }}</a>
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
