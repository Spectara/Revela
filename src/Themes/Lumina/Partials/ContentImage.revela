{{~##
Content Image Template - Lumina Theme

Renders a responsive <picture> element for images in Markdown body content.
This template is called by the Markdown image renderer for ![alt](path) syntax.

Context variables:
- image: ImageData { slug, width, height, sizes, placeholder? }
- alt: Alt text from Markdown
- classes: Optional CSS classes from Markdown generic attributes {.class}
- assets_basepath: Path/URL to image folder
- image_formats: Available formats ["avif", "webp", "jpg"]
##~}}
{{~ if !image.sizes || image.sizes.size == 0; ret; end ~}}
{{~ include 'imagehelpers' ~}}
{{~ fallback_format = image_fallback_format ~}}
{{~ ## The text column is at most 900px wide (--content-max-width); "auto" lets browsers
   that support it use the laid-out width instead. ## ~}}
{{~ content_sizes = 'auto, (min-width: 900px) 900px, 100vw' ~}}
<picture class="content-image{{ for cls in classes }} {{ html_escape cls }}{{ end }}"{{ if image.placeholder }} style="--lqip:{{ html_escape image.placeholder }}" data-lqip{{ end }}>
{{~ for format in image_formats ~}}
  <source type="{{ html_escape (image_type format) }}" sizes="{{ content_sizes }}" srcset="{{ html_escape (image_srcset image format) }}">
{{~ end ~}}
    <img src="{{ html_escape (variant_url image (image_size image 1280) fallback_format) }}" sizes="{{ content_sizes }}" srcset="{{ html_escape (image_srcset image fallback_format) }}" alt="{{ html_escape alt }}"
      width="{{ html_escape image.width }}" height="{{ html_escape image.height }}" loading="lazy" decoding="async">
</picture>
