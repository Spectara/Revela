{{~##
  Recursive Navigation Template - Lumina Theme

  Structure:
  - Section with children: <section><p>Title</p>...children...</section>
  - Section with link: <section><p><a>Title</a></p>...children...</section>
  - Top-level leaf: <a href="#">Title</a> (flat navigation)
  - Branch with link: <div><a href="#">Title</a>...children...</div>
  - Branch without link: <div><span>Title</span>...children...</div>
  - Leaf: <a href="#">Title</a>

  Section titles are labels, not headings: the overlay menu precedes <main>, so headings
  here would come before the page's <h1> in the document outline.

  Expects: nav_items (Array of NavigationItem)
  NavigationItem: { text, url?, active?, current?, children }
  - active: true if this item or any child is the current page (for breadcrumbs)
  - current: true only if this item is the exact current page (aria-current="page")
  - page_url(item): link to the item's page, or empty for section headers
##~}}
{{~ func render_item(item, is_top_level) ~}}
{{~ link = page_url(item) ~}}
{{~ if is_top_level ~}}
{{~ if item.children.size > 0 ~}}
{{~ # Top-level with children = section ~}}
<section>
{{~ if link ~}}
  <p><a href="{{ html_escape link }}"{{ item.current ? ' aria-current="page"' : '' }}>{{ html_escape item.text }}</a></p>
{{~ else ~}}
  <p>{{ html_escape item.text }}</p>
{{~ end ~}}
{{~ for child in item.children ~}}
{{~ render_item child false ~}}
{{~ end ~}}
</section>
{{~ else ~}}
{{~ # Top-level leaf = section with heading link (consistent with branch sections) ~}}
<section>
  <p><a href="{{ html_escape link }}"{{ item.current ? ' aria-current="page"' : '' }}>{{ html_escape item.text }}</a></p>
</section>
{{~ end ~}}
{{~ else if item.children.size > 0 ~}}
{{~ # Branch: Has children ~}}
<div>
{{~ if link ~}}
  <a href="{{ html_escape link }}"{{ item.current ? ' aria-current="page"' : '' }}>{{ html_escape item.text }}</a>
{{~ else ~}}
  <span>{{ html_escape item.text }}</span>
{{~ end ~}}
{{~ for child in item.children ~}}
{{~ render_item child false ~}}
{{~ end ~}}
</div>
{{~ else ~}}
{{~ # Leaf: Simple link ~}}
  <a href="{{ html_escape link }}"{{ item.current ? ' aria-current="page"' : '' }}>{{ html_escape item.text }}</a>
{{~ end ~}}
{{~ end ~}}
{{~ for item in nav_items ~}}
{{~ render_item item true ~}}
{{~ end ~}}
