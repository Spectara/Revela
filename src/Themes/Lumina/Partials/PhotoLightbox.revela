{{~##
Native lightbox dialog for one gallery image occurrence.

Expects image, image_formats, assets_basepath, occurrence_id, context_label,
previous_occurrence_id, next_occurrence_id, lightbox_id, and alt_text.
##~}}
{{~ include 'imagehelpers' ~}}
{{~ fallback_format = image_fallback_format ~}}
{{~ # Fit the viewport; zoom.js switches sizes to the original width when zooming in. ~}}
{{~ photo_sizes = viewer_sizes image ~}}
{{~ display_label = alt_text != '' ? alt_text : (image.description && image.description != '' ? image.description : image.id) ~}}
<dialog id="{{ html_escape lightbox_id }}" class="photo-lightbox" data-lightbox aria-label="{{~ if alt_text != '' }}{{ html_escape alt_text }}{{ else }}{{ html_escape (t 'photo.label' image.id) }}{{ end }}">
    <button type="button" commandfor="{{ html_escape lightbox_id }}" command="close" aria-label="{{ html_escape (t 'photo.close') }}">&times;</button>
    <article style="--width:{{ html_escape image.width }}; --height:{{ html_escape image.height }};{{~ if image.color ~}} --image-color:{{ html_escape image.color }};{{~ end ~}}">
        <picture>
            {{~ for format in image_formats ~}}
            <source type="{{ html_escape (image_type format) }}" sizes="{{ html_escape photo_sizes }}" srcset="{{ html_escape (image_srcset image format) }}">
            {{~ end ~}}
            <img alt="{{ html_escape alt_text }}" src="{{ html_escape (variant_url image image.sizes[-1] fallback_format) }}"
                sizes="{{ html_escape photo_sizes }}" srcset="{{ html_escape (image_srcset image fallback_format) }}"
                width="{{ html_escape image.width }}" height="{{ html_escape image.height }}" loading="lazy" fetchpriority="low" decoding="async">
        </picture>
        <section>
            <nav aria-label="{{ html_escape (t 'photo.navigation') }}">
                {{~ if previous_occurrence_id ~}}
                <button type="button" hidden aria-controls="lightbox-{{ html_escape previous_occurrence_id }}" data-photo-previous data-lightbox-target="lightbox-{{ html_escape previous_occurrence_id }}" aria-label="{{ html_escape (t 'photo.previous') }}"><span aria-hidden="true">&lsaquo;</span></button>
                {{~ else ~}}
                <span data-photo-previous aria-hidden="true"></span>
                {{~ end ~}}
                <span data-photo-label>{{ html_escape display_label }}</span>
                {{~ if next_occurrence_id ~}}
                <button type="button" hidden aria-controls="lightbox-{{ html_escape next_occurrence_id }}" data-photo-next data-lightbox-target="lightbox-{{ html_escape next_occurrence_id }}" aria-label="{{ html_escape (t 'photo.next') }}"><span aria-hidden="true">&rsaquo;</span></button>
                {{~ else ~}}
                <span data-photo-next aria-hidden="true"></span>
                {{~ end ~}}
            </nav>
            {{~ include 'photometadata' image ~}}
            <footer>
                <strong>{{ html_escape (t 'photo.seen_in') }}</strong>
                <span>{{ html_escape context_label }}</span>
            </footer>
        </section>
    </article>
</dialog>