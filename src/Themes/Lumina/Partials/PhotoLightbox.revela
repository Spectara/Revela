{{~##
Native lightbox dialog for one gallery image occurrence.

Expects image, image_formats, assets_basepath, occurrence_id, context_label,
previous_occurrence_id, next_occurrence_id, lightbox_id, and alt_text.
##~}}
{{~ largest_size = image.sizes | array.last ~}}
{{~ display_label = image.description && image.description != '' ? image.description : image.id ~}}
<dialog id="{{ html_escape lightbox_id }}" class="photo-lightbox" data-lightbox closedby="any" aria-label="{{~ if alt_text != '' }}{{ html_escape alt_text }}{{ else }}Photo {{ html_escape image.id }}{{ end }}">
    <button type="button" commandfor="{{ html_escape lightbox_id }}" command="close" aria-label="Close photo">&times;</button>
    <article style="--width:{{ html_escape image.width }}; --height:{{ html_escape image.height }};{{~ if image.placeholder ~}} --lqip:{{ html_escape image.placeholder }};{{~ end ~}}">
        <picture{{~ if image.placeholder }} data-lqip{{ end }}>
            {{~ for format in image_formats ~}}
            <source type="image/{{ html_escape format }}" srcset="{{ html_escape assets_basepath }}{{ html_escape image.slug }}/{{ html_escape largest_size }}.{{ html_escape format }}">
            {{~ end ~}}
            <img alt="{{ html_escape alt_text }}" src="{{ html_escape assets_basepath }}{{ html_escape image.slug }}/{{ html_escape largest_size }}.{{ html_escape (image_formats | array.last) }}"
                width="{{ html_escape image.width }}" height="{{ html_escape image.height }}" loading="lazy" fetchpriority="low" decoding="async">
        </picture>
        <section>
            <nav aria-label="Photo navigation">
                {{~ if previous_occurrence_id ~}}
                <button type="button" hidden aria-controls="lightbox-{{ html_escape previous_occurrence_id }}" data-photo-previous data-lightbox-target="lightbox-{{ html_escape previous_occurrence_id }}" aria-label="Previous photo"><span aria-hidden="true">&lsaquo;</span></button>
                {{~ else ~}}
                <span aria-hidden="true"></span>
                {{~ end ~}}
                <span data-photo-label>{{ html_escape display_label }}</span>
                {{~ if next_occurrence_id ~}}
                <button type="button" hidden aria-controls="lightbox-{{ html_escape next_occurrence_id }}" data-photo-next data-lightbox-target="lightbox-{{ html_escape next_occurrence_id }}" aria-label="Next photo"><span aria-hidden="true">&rsaquo;</span></button>
                {{~ else ~}}
                <span aria-hidden="true"></span>
                {{~ end ~}}
            </nav>
            {{~ include 'photometadata' image ~}}
            <footer>
                <strong>Tags:</strong>
                <span>{{ html_escape context_label }}</span>
                {{~ for tag in image.tags ~}}<span>{{ html_escape tag }}</span>{{~ end ~}}
            </footer>
        </section>
    </article>
</dialog>