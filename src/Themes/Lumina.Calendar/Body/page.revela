{{~##
Calendar Page Body Template - Lumina Calendar Extension

Heading: the page title is the single <h1>, unless the Markdown body brings its own.
##~}}
{{~ body_has_h1 = gallery.body && (gallery.body | string.contains '<h1') ~}}
<section>
{{~ if !body_has_h1 ~}}
<h1>{{ html_escape ((gallery.title && gallery.title != '') ? gallery.title : site.title) }}</h1>
{{~ end ~}}
{{ gallery.body }}
{{~ if !calendar ~}}
{{~ # calendar.json is missing, e.g. `generate scan` dropped stale data and the calendar step has not run yet ~}}
<p>{{ html_escape (t 'calendar.no_data') }}</p>
{{~ end ~}}
</section>
{{~ if calendar ~}}

<div class="calendar-legend">
  <span class="legend-free">{{ html_escape (calendar.labels.free ?? (t 'calendar.free')) }}</span>
  <span class="legend-arrive">{{ html_escape (calendar.labels.arrive ?? (t 'calendar.arrive')) }}</span>
  <span class="legend-depart">{{ html_escape (calendar.labels.depart ?? (t 'calendar.depart')) }}</span>
  <span class="legend-booked">{{ html_escape (calendar.labels.booked ?? (t 'calendar.booked')) }}</span>
</div>

<div class="calendar-grid">
{{ for month in calendar.months }}
  <div class="calendar-month">
    <h2>{{ html_escape month.name }}</h2>
    <table>
      <thead>
        <tr>
          {{ for name in calendar.day_names }}<th>{{ html_escape name }}</th>{{ end }}
        </tr>
      </thead>
      <tbody>
      {{ for week in month.weeks }}
        <tr>
        {{ for day in week }}
          {{ if day.number == 0 }}
          <td></td>
          {{ else }}
          <td class="{{ html_escape day.css }}">{{ html_escape day.number }}</td>
          {{ end }}
        {{ end }}
        </tr>
      {{ end }}
      </tbody>
    </table>
  </div>
{{ end }}
</div>
{{~ end ~}}
