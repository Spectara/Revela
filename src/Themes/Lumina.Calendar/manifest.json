{
    "name": "Lumina Calendar",
    "description": "Availability calendar extension for the Lumina theme",
    "author": "Spectara",
    "targetTheme": "Lumina",
    "prefix": "calendar",
    "templateDefaults": {
        "calendar/page": {
            "data": {
                "calendar": "calendar.json"
            }
        }
    },
    "stylesheets": [
        { "path": "calendar.css", "scope": ["calendar"] }
    ]
}
