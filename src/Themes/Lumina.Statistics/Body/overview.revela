{{~##
Statistics Overview Body Template - Lumina Statistics Extension

Renders a statistics overview page with summary cards and bar charts.
Uses the shared bar-chart partial for all chart sections.

Note: Scriban include does NOT support passing object literals as arguments.
Variables must be set before include so the partial can access them.

Expects:
- statistics: Statistics data object with:
  - total_images, total_galleries
  - cameras, lenses, focal_lengths, apertures, shutter_speeds
  - iso_values, orientations, images_by_year, images_by_month
  Each array item has: name, count, percentage
##~}}
<section>
<h1>{{ html_escape ((gallery.title && gallery.title != '') ? gallery.title : (t 'statistics.overview')) }}</h1>
<h2>{{ html_escape (t 'statistics.overview') }}</h2>

<p class="stats-summary">
    <span><strong>{{ html_escape statistics.total_images }}</strong> {{ html_escape (t 'statistics.images') }}</span>
    <span><strong>{{ html_escape statistics.total_galleries }}</strong> {{ html_escape (t 'statistics.galleries') }}</span>
    <span><strong>{{ statistics.cameras | array.size }}</strong> {{ html_escape (t 'statistics.cameras') }}</span>
    <span><strong>{{ statistics.lenses | array.size }}</strong> {{ html_escape (t 'statistics.lenses') }}</span>
</p>

{{~ if statistics.cameras && statistics.cameras.size > 0 ~}}
{{~ chart_title = (t 'statistics.camera_models'); chart_items = statistics.cameras ~}}
{{ include 'statistics/bar-chart' }}
{{~ end ~}}
{{~ if statistics.lenses && statistics.lenses.size > 0 ~}}
{{~ chart_title = (t 'statistics.lenses'); chart_items = statistics.lenses ~}}
{{ include 'statistics/bar-chart' }}
{{~ end ~}}
{{~ if statistics.focal_lengths && statistics.focal_lengths.size > 0 ~}}
{{~ chart_title = (t 'statistics.focal_length'); chart_items = statistics.focal_lengths ~}}
{{ include 'statistics/bar-chart' }}
{{~ end ~}}
{{~ if statistics.apertures && statistics.apertures.size > 0 ~}}
{{~ chart_title = (t 'statistics.aperture'); chart_items = statistics.apertures ~}}
{{ include 'statistics/bar-chart' }}
{{~ end ~}}
{{~ if statistics.shutter_speeds && statistics.shutter_speeds.size > 0 ~}}
{{~ chart_title = (t 'statistics.shutter_speed'); chart_items = statistics.shutter_speeds ~}}
{{ include 'statistics/bar-chart' }}
{{~ end ~}}
{{~ if statistics.iso_values && statistics.iso_values.size > 0 ~}}
{{~ chart_title = (t 'statistics.iso'); chart_items = statistics.iso_values ~}}
{{ include 'statistics/bar-chart' }}
{{~ end ~}}
{{~ if statistics.orientations && statistics.orientations.size > 0 ~}}
{{~ chart_title = (t 'statistics.orientation'); chart_items = statistics.orientations ~}}
{{ include 'statistics/bar-chart' }}
{{~ end ~}}
{{~ if statistics.photo_heatmap && statistics.photo_heatmap.size > 0 ~}}
{{~ chart_items = statistics.photo_heatmap; chart_years = statistics.heatmap_years ~}}
{{ include 'statistics/heatmap' }}
{{~ end ~}}
{{~ if statistics.images_by_year && statistics.images_by_year.size > 0 ~}}
{{~ chart_title = (t 'statistics.timeline'); chart_items = statistics.images_by_year ~}}
{{ include 'statistics/bar-chart' }}
{{~ end ~}}
{{~ if statistics.images_by_month && statistics.images_by_month.size > 0 ~}}
{{~ chart_title = (t 'statistics.photos_by_month'); chart_items = statistics.images_by_month ~}}
{{ include 'statistics/bar-chart' }}
{{~ end ~}}

</section>

