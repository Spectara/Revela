{{~##
Docs Body Template - Documentation with Sidebar

Renders a documentation page with sidebar navigation.
Supports nested documentation at any depth (e.g., docs/guide/source-structure/static-files);
every level is listed in the sidebar, indented below its parent.

The sidebar sits in a <details> element: collapsed on small screens so the
article title is on the first screen, forced open on wide screens via CSS
(website.css). Without JS or ::details-content support it stays a working
toggle. Rendered tables are wrapped so they scroll on their own instead of
widening the page.

Expects:
- gallery: { title, body }
- nav_items: Array of NavigationItem for sidebar

Heading: like Lumina, exactly one <h1> per page. The title is the <h1> unless the
rendered Markdown body already contains one (`# Heading`).
##~}}
{{~ # Renders the docs tree at any depth (e.g. Docs / Guide / Source Structure / Static Files). ~}}
{{~ func render_docs_items(items) ~}}
<ul>
{{~ for doc in items ~}}
{{~ doc_link = page_url(doc) ~}}
<li>
{{~ if doc_link ~}}
<a href="{{ html_escape doc_link }}"{{ if doc.current }} aria-current="page"{{ end }}>{{ html_escape doc.text }}</a>
{{~ else ~}}
<span>{{ html_escape doc.text }}</span>
{{~ end ~}}
{{~ if doc.children.size > 0 ~}}
{{~ render_docs_items doc.children ~}}
{{~ end ~}}
</li>
{{~ end ~}}
</ul>
{{~ end ~}}
{{~ body_has_h1 = gallery.body && (gallery.body | string.contains '<h1') ~}}
{{~ section = null ~}}
{{~ for item in nav_items ~}}
{{~ if !section && (item.active || item.text == gallery.title); section = item; end ~}}
{{~ end ~}}
<aside>
{{~ if section && section.children.size > 0 ~}}
    <details>
        <summary>{{ html_escape section.text }} menu</summary>
        <nav aria-label="{{ html_escape section.text }}">
{{~ render_docs_items section.children ~}}
        </nav>
    </details>
{{~ end ~}}
</aside>
<article>
{{~ if gallery.title && !body_has_h1 ~}}
    <h1>{{ html_escape gallery.title }}</h1>
{{~ end ~}}
{{~ if gallery.body ~}}
{{ gallery.body | string.replace '<table>' '<div class="table-scroll"><table>' | string.replace '</table>' '</table></div>' }}
{{~ end ~}}
</article>
